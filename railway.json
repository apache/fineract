{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/fineract-provider/actuator/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "always",
    "sleepApplication": false
  }
}
