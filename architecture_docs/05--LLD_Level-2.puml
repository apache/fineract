@startuml Fineract-LLD_Level-2
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

' Force top to bottom layout
top to bottom direction

title Apache Fineract - Low Level Design Level 2 (Detailed Component Architecture)

' External Systems
System_Ext(client_apps, "Client Applications", "Mobile & Web interfaces")
System_Ext(external_integrations, "External Systems", "Payment gateways, SMS, etc.")

' Main Fineract System
System_Boundary(fineract_system, "Apache Fineract Platform") {
    
    ' API and Web Layer - Detailed Components
    Container_Boundary(web_api_layer, "fineract-provider: Web & API Layer") {
        
        ' REST API Controllers with detailed endpoints
        Container_Boundary(rest_api_controllers, "REST API Controllers") {
            Component(client_api, "ClientApiResource", "JAX-RS Controller", "• GET /clients\n• POST /clients\n• PUT /clients/{id}\n• DELETE /clients/{id}\n• GET /clients/{id}/accounts")
            Component(loans_api, "LoansApiResource", "JAX-RS Controller", "• GET /loans\n• POST /loans\n• PUT /loans/{id}\n• POST /loans/{id}/transactions\n• GET /loans/{id}/schedule")
            Component(savings_api, "SavingsApiResource", "JAX-RS Controller", "• GET /savingsaccounts\n• POST /savingsaccounts\n• PUT /savingsaccounts/{id}\n• POST /savingsaccounts/{id}/transactions")
            Component(accounting_api, "AccountingApiResource", "JAX-RS Controller", "• GET /journalentries\n• POST /journalentries\n• GET /glaccounts\n• POST /glaccounts")
            Component(reports_api, "ReportsApiResource", "JAX-RS Controller", "• GET /reports\n• POST /reports/run\n• GET /reports/{id}/template")
        }
        
        ' Security Layer with detailed filters
        Container_Boundary(security_layer, "Security & Authentication") {
            Component(oauth2_filter, "OAuth2AuthenticationFilter", "Security Filter", "• Token validation\n• Scope verification\n• User authentication\n• Authority extraction")
            Component(tenant_filter, "TenantAwareFilter", "Multi-tenant Filter", "• Tenant identification\n• Schema context setup\n• Tenant validation\n• Context cleanup")
            Component(authorization_filter, "AuthorizationFilter", "Permission Filter", "• Role-based access\n• Resource permissions\n• Method-level security\n• Audit logging")
            Component(cors_filter, "CorsFilter", "Cross-Origin Filter", "• CORS headers\n• Preflight handling\n• Origin validation")
        }
        
        ' Exception Handling System
        Container_Boundary(exception_handling, "Exception Management") {
            Component(global_handler, "GlobalExceptionHandler", "Exception Handler", "• HTTP status mapping\n• Error response formatting\n• Stack trace handling\n• Logging integration")
            Component(validation_handler, "ValidationExceptionHandler", "Validation Handler", "• Field validation errors\n• Business rule violations\n• Custom error messages\n• Error code mapping")
            Component(platform_exceptions, "PlatformExceptions", "Custom Exceptions", "• PlatformApiDataValidationException\n• PlatformServiceUnavailableException\n• PlatformDataIntegrityException")
