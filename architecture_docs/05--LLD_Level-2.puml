            Component(response_dtos, "Response DTOs", "Response Objects", "• ApiRequestJsonSerializationSettings\n• CommandProcessingResult\n• PagedResponse\n• ErrorResponse")
            Component(api_constants, "ApiConstants", "API Configuration", "• URL patterns\n• Parameter names\n• Response codes\n• Content types")
        }
    }
    
