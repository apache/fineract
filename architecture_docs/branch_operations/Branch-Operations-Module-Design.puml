Role --> Permission : "contains permissions"
Holiday --> Office : "applies to offices"
WorkingDays --> Office : "configured for office"
Teller --> Office : "located at office"
Teller --> CashierAllocation : "has cashier allocations"
CashierAllocation --> Staff : "allocated to staff"
OfficeTransaction --> Office : "from/to offices"

