# Copy this file to .env and replace every value with a unique random secret.
# Generate suitable values with: openssl rand -hex 32
POSTGRES_ROOT_PASSWORD=replace-with-a-random-secret
FINERACT_DB_PASSWORD=replace-with-a-different-random-secret
FINERACT_MASTER_PASSWORD=replace-with-another-random-secret
