actor "Loan Officer" as user
participant "ApiResource" as api
participant "CommandHandler" as handler
participant "WriteServiceImpl" as svc
participant "ParseAndValidator" as val
participant "ActionRepository" as repo
database "m_wc_loan_*_action" as db

user -> api : POST .../delinquency-actions\n{ "action":"disable", "startDate": today }
api -> api : validateHasCreatePermission(WC_..._ACTION)
api -> api : validateHasCreatePermission(WC_..._DISABLE)
api -> handler : logCommandSource (CREATE)
handler -> svc : createAction(loanId, command)
svc -> val : validateAndParse(command, loan, existing)
val -> val : startDate == business date ?
val -> val : endDate absent ?
val -> repo : isDisabledAsOf(loanId, today)
repo --> val : false
val --> svc : parsed DISABLE action (endDate = null)
svc -> db : insert DISABLE row (end_date = NULL)
note over svc : Delinquency: lift active\nclassification as of startDate
svc --> api : CommandProcessingResult(resourceId)
api --> user : 200 OK

@enduml
