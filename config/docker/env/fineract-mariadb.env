# Apache Fineract MariaDB Configuration

# MariaDB JDBC Driver
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.mariadb.jdbc.Driver

# JDBC connection to MariaDB using Railway internal host
FINERACT_HIKARI_JDBC_URL=jdbc:mariadb://mariadb.railway.internal:3306/${MARIADB_DATABASE}

# Default tenant database connection config
FINERACT_DEFAULT_TENANTDB_HOST=mariadb.railway.internal
FINERACT_DEFAULT_TENANTDB_PORT=3306
FINERACT_DEFAULT_TENANTDB_NAME=${MARIADB_DATABASE}
FINERACT_DEFAULT_TENANTDB_UID=${MARIADB_USER}
FINERACT_DEFAULT_TENANTDB_PWD=${MARIADB_PASSWORD}
