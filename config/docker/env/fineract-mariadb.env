# Apache Fineract MariaDB Configuration

# Database Driver for MariaDB
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.mariadb.jdbc.Driver

# JDBC URL to connect to your MariaDB instance (no credentials inline)
FINERACT_HIKARI_JDBC_URL=jdbc:mariadb://fineract.railway.internal:3306/railway

# Default tenant database configuration (used to create default tenant)
FINERACT_DEFAULT_TENANTDB_HOST=fineract.railway.internal
FINERACT_DEFAULT_TENANTDB_PORT=3306
FINERACT_DEFAULT_TENANTDB_NAME=railway
FINERACT_DEFAULT_TENANTDB_UID=railway
FINERACT_DEFAULT_TENANTDB_PWD=${MARIADB_PASSWORD}
