<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
    "https://checkstyle.org/dtds/import_control_1_4.dtd">

<!--
    Packages that have been migrated to the new command processing infrastructure
    (fineract-command, FSIP-5). Code in these packages must not import the legacy command
    API: the org.apache.fineract.commands package (NewCommandSourceHandler, @CommandType,
    CommandWrapperBuilder, PortfolioCommandSourceWritePlatformService, ...), JsonCommand or
    FromJsonHelper. Every other package is unaffected.

    This list only grows. When a feature has been migrated and no longer imports any of the
    above, add its package here with the same three rules. Do not remove a package to make
    a build pass: use the new API instead (see fineract-command/REFACTORING.md).
-->

<import-control pkg="org.apache.fineract" strategyOnMismatch="allowed">
    <subpackage name="infrastructure">
        <subpackage name="businessdate">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
        <subpackage name="cache">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
        <subpackage name="documentmanagement">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
        <subpackage name="event">
            <subpackage name="external">
                <disallow pkg="org.apache.fineract.commands"/>
                <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
                <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
            </subpackage>
        </subpackage>
        <subpackage name="hooks">
            <!-- Hooks select events by entity and action name, so the name constants stay allowed. -->
            <allow class="org\.apache\.fineract\.commands\.domain\.CommandWrapperConstants(\.\w+)?" regex="true"/>
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
    </subpackage>
    <subpackage name="organisation">
        <subpackage name="monetary">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
        <subpackage name="staff">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
    </subpackage>
    <subpackage name="portfolio">
        <subpackage name="floatingrates">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
        <subpackage name="loanproduct">
            <subpackage name="productmix">
                <disallow pkg="org.apache.fineract.commands"/>
                <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
                <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
            </subpackage>
        </subpackage>
        <subpackage name="note">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
        <subpackage name="paymenttype">
            <disallow pkg="org.apache.fineract.commands"/>
            <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
            <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
        </subpackage>
    </subpackage>
    <subpackage name="template">
        <disallow pkg="org.apache.fineract.commands"/>
        <disallow class="org.apache.fineract.infrastructure.core.api.JsonCommand"/>
        <disallow class="org.apache.fineract.infrastructure.core.serialization.FromJsonHelper"/>
    </subpackage>
</import-control>
