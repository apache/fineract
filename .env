# Railway Environment Variables for Apache Fineract
# PostgreSQL Database Configuration
DATABASE_URL=${{RAILWAY_DATABASE_URL}}
PGHOST=${{RAILWAY_PGHOST}}
PGPORT=${{RAILWAY_PGPORT}}
PGUSER=${{RAILWAY_PGUSER}}
PGPASSWORD=${{RAILWAY_PGPASSWORD}}
PGDATABASE=${{RAILWAY_PGDATABASE}}

# Redis/Dragonfly Configuration
REDIS_URL=${{RAILWAY_REDIS_URL}}
REDIS_HOST=${{RAILWAY_REDIS_HOST}}
REDIS_PORT=${{RAILWAY_REDIS_PORT}}

# Application Configuration
PORT=${{PORT}}
JAVA_OPTS="-Xms1g -Xmx4g -XX:+UseG1GC"
SPRING_PROFILES_ACTIVE="railway,postgresql"

# Security
JWT_SECRET=${{JWT_SECRET}}
FINERACT_TENANTS_DATABASE_PASSWORD=${{RAILWAY_PGPASSWORD}}

# Monitoring
SENTRY_DSN=${{SENTRY_DSN}}
ROLLBAR_ACCESS_TOKEN=${{ROLLBAR_ACCESS_TOKEN}}
