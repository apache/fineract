<!--
    Runs the real command changelog parts, but seeds rows with duplicate idempotency keys just before the
    unique constraint is applied. This is the situation on any system that ran an earlier build.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <include file="db/changelog/tenant/module/command/parts/0001_command_init.xml"/>
    <include file="db/changelog/tenant/module/command/parts/0002_command_fix_structure.xml"/>

    <changeSet author="test" id="command-test-seed-duplicates" context="postgresql,mysql">
        <!-- KEEP-1: the original command plus two surplus rows written by an earlier replay path -->
        <insert tableName="m_command">
            <column name="id" valueNumeric="1"/>
            <column name="idempotency_key" value="KEEP-1"/>
            <column name="state" value="PROCESSED"/>
            <column name="request" value="original"/>
        </insert>
        <insert tableName="m_command">
            <column name="id" valueNumeric="2"/>
            <column name="idempotency_key" value="KEEP-1"/>
            <column name="state" value="INVALID"/>
            <column name="request" value="surplus"/>
        </insert>
        <insert tableName="m_command">
            <column name="id" valueNumeric="3"/>
            <column name="idempotency_key" value="KEEP-1"/>
            <column name="state" value="INVALID"/>
            <column name="request" value="surplus"/>
        </insert>
        <!-- KEEP-2: a key with a single row; must survive untouched -->
        <insert tableName="m_command">
            <column name="id" valueNumeric="4"/>
            <column name="idempotency_key" value="KEEP-2"/>
            <column name="state" value="PROCESSED"/>
            <column name="request" value="original"/>
        </insert>
        <!-- rows without a key; several are allowed and all must survive -->
        <insert tableName="m_command">
            <column name="id" valueNumeric="5"/>
            <column name="state" value="PROCESSED"/>
            <column name="request" value="no-key"/>
        </insert>
        <insert tableName="m_command">
            <column name="id" valueNumeric="6"/>
            <column name="state" value="PROCESSED"/>
            <column name="request" value="no-key"/>
        </insert>
    </changeSet>

    <include file="db/changelog/tenant/module/command/parts/0003_command_action_entity.xml"/>
    <include file="db/changelog/tenant/module/command/parts/0004_idempotency_key_unique.xml"/>
    <include file="db/changelog/tenant/module/command/parts/0005_command_response_cache.xml"/>

</databaseChangeLog>
