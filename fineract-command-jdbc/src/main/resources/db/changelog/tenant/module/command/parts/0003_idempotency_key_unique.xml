<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="fineract" id="command-00005" context="postgresql,mysql">
        <delete tableName="m_command">
            <where>
                idempotency_key IN (
                    SELECT c1.idempotency_key
                    FROM m_command c1
                    INNER JOIN m_command c2
                        ON c1.idempotency_key = c2.idempotency_key
                        AND c1.id > c2.id
                )
            </where>
        </delete>
        <dropIndex tableName="m_command" indexName="m_command_idempotency_key_index" />
        <addUniqueConstraint
                tableName="m_command"
                columnNames="idempotency_key"
                constraintName="m_command_idempotency_key_index"/>
    </changeSet>
</databaseChangeLog>
