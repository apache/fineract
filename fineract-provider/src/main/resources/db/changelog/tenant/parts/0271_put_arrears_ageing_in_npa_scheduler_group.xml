<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        A scheduler group greater than 0 gets a Quartz scheduler of its own with a single thread (see
        0259_put_cob_jobs_in_one_scheduler_group.xml for the same pattern used for the COB jobs), so jobs in it
        never run concurrently; among triggers due at the same fire time, the one with the highest task_priority
        goes first (an earlier fire time still wins over a later, higher-priority one). "Update Non Performing
        Assets" is already in group 3 and, per 0263, now fires at the same 00:01 time as "Update Loan Arrears
        Ageing" - but without this changeset the two jobs are still in different scheduler groups (0 vs 3), so
        that alone gives no ordering at all between them, let alone stopping NPA from running concurrently
        against a partially-rebuilt m_loan_arrears_aging if arrears ageing overruns into NPA's turn.
        Moving arrears ageing into the same group, with a higher task_priority than every job already in it,
        makes NPA's trigger simply wait for the shared thread instead, however long arrears ageing takes.
    -->
    <changeSet id="1" author="fineract">
        <update tableName="job">
            <column name="scheduler_group" valueNumeric="3"/>
            <column name="task_priority" valueNumeric="7"/>
            <where>name='Update Loan Arrears Ageing'</where>
        </update>
    </changeSet>
</databaseChangeLog>
