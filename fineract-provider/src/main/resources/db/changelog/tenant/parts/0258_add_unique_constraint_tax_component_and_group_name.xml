<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!-- Existing duplicates keep the name on the oldest row; later rows get their id appended so the constraint can be added -->
    <changeSet author="fineract" id="1">
        <sql>
            UPDATE m_tax_component SET name = CONCAT(SUBSTRING(name, 1, 30), ' (', id, ')')
            WHERE id IN (SELECT dup.id FROM (SELECT c.id FROM m_tax_component c
                WHERE EXISTS (SELECT 1 FROM m_tax_component o WHERE o.name = c.name AND o.id &lt; c.id)) dup)
        </sql>
    </changeSet>
    <changeSet author="fineract" id="2">
        <sql>
            UPDATE m_tax_group SET name = CONCAT(SUBSTRING(name, 1, 30), ' (', id, ')')
            WHERE id IN (SELECT dup.id FROM (SELECT g.id FROM m_tax_group g
                WHERE EXISTS (SELECT 1 FROM m_tax_group o WHERE o.name = g.name AND o.id &lt; g.id)) dup)
        </sql>
    </changeSet>
    <changeSet author="fineract" id="3">
        <addUniqueConstraint tableName="m_tax_component" columnNames="name" constraintName="uq_m_tax_component_name"/>
    </changeSet>
    <changeSet author="fineract" id="4">
        <addUniqueConstraint tableName="m_tax_group" columnNames="name" constraintName="uq_m_tax_group_name"/>
    </changeSet>
</databaseChangeLog>
