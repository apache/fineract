<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        Loans that were closed (600, 601, 602) or became overpaid (700) while NPA kept the flag for good, because
        the NPA processing only evaluates active loans. Settling a loan now clears it; this clears the loans
        settled before that.
    -->
    <changeSet id="1" author="fineract">
        <update tableName="m_loan">
            <column name="is_npa" valueBoolean="false"/>
            <where>is_npa = true AND loan_status_id IN (600, 601, 602, 700)</where>
        </update>
    </changeSet>
</databaseChangeLog>
