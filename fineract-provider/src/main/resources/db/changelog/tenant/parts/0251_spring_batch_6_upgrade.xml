<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        As per Spring Batch 6.0 migration guide
        (https://github.com/spring-projects/spring-batch/wiki/Spring-Batch-6.0-Migration-Guide)
    -->
    <changeSet author="fineract" id="1" context="postgresql">
        <!--
            org/springframework/batch/core/migration/6.0/migration-postgresql.sql
        -->
        <sql>
            ALTER SEQUENCE BATCH_JOB_SEQ RENAME TO BATCH_JOB_INSTANCE_SEQ;
        </sql>
    </changeSet>
    <changeSet author="fineract" id="1" context="mysql">
        <!--
            org/springframework/batch/core/migration/6.0/migration-mysql.sql
            (Fineract emulates the sequence as a table - see 0021_add_spring_batch_db_structure.xml)
        -->
        <sql>
            RENAME TABLE BATCH_JOB_SEQ TO BATCH_JOB_INSTANCE_SEQ;
        </sql>
    </changeSet>
</databaseChangeLog>
