<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        As per the Spring Batch 6.0 migration scripts shipped in spring-batch-core
        (org/springframework/batch/core/migration/6.0): the job instance sequence
        BATCH_JOB_SEQ was renamed to BATCH_JOB_INSTANCE_SEQ. On MySQL and MariaDB the
        sequence is emulated as a table (see 0021_add_spring_batch_db_structure.xml and
        FineractDataFieldMaxValueIncrementerFactory), so the rename is a table rename there.
    -->
    <changeSet author="fineract" id="1" context="postgresql">
        <sql>
            ALTER SEQUENCE BATCH_JOB_SEQ RENAME TO BATCH_JOB_INSTANCE_SEQ
        </sql>
    </changeSet>
    <changeSet author="fineract" id="1-mysql" context="mysql">
        <sql>
            RENAME TABLE BATCH_JOB_SEQ TO BATCH_JOB_INSTANCE_SEQ
        </sql>
    </changeSet>
    <!--
        Batch 5's Jackson2ExecutionContextStringSerializer wrote polymorphic type information as an
        "@class" property (DefaultTyping.NON_FINAL + JsonTypeInfo.As.PROPERTY). Batch 6's
        JacksonExecutionContextStringSerializer uses OBJECT_AND_NON_CONCRETE + As.WRAPPER_ARRAY. The
        two formats are mutually unreadable: scalar-only contexts would silently retain "@class" as a
        spurious context key, and nested objects - which is what COB writes (COBParameter and
        Set<BusinessStepNameAndOrder> in the partition step contexts) - fail outright with
        MismatchedInputException on the first post-upgrade run of any job with execution history.

        Stale context rows are therefore archived. JdbcExecutionContextDao.getExecutionContext returns
        an empty ExecutionContext when no row is present, so this is safe for completed executions.

        NOTE: no in-flight batch job may span this upgrade - a job interrupted before it and restarted
        after it will have lost its saved context.
    -->
    <changeSet author="fineract" id="2">
        <renameTable oldTableName="BATCH_STEP_EXECUTION_CONTEXT" newTableName="OLD_BATCH_STEP_EXECUTION_CONTEXT"/>
        <createTable tableName="BATCH_STEP_EXECUTION_CONTEXT">
            <column name="STEP_EXECUTION_ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="SHORT_CONTEXT" type="VARCHAR(2500)">
                <constraints nullable="false"/>
            </column>
            <column name="SERIALIZED_CONTEXT" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="BATCH_STEP_EXECUTION_CONTEXT" baseColumnNames="STEP_EXECUTION_ID" constraintName="STEP_EXEC_CTX_FK" referencedTableName="BATCH_STEP_EXECUTION" referencedColumnNames="STEP_EXECUTION_ID"/>
    </changeSet>
    <changeSet author="fineract" id="3">
        <renameTable oldTableName="BATCH_JOB_EXECUTION_CONTEXT" newTableName="OLD_BATCH_JOB_EXECUTION_CONTEXT"/>
        <createTable tableName="BATCH_JOB_EXECUTION_CONTEXT">
            <column name="JOB_EXECUTION_ID" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="SHORT_CONTEXT" type="VARCHAR(2500)">
                <constraints nullable="false"/>
            </column>
            <column name="SERIALIZED_CONTEXT" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="BATCH_JOB_EXECUTION_CONTEXT" baseColumnNames="JOB_EXECUTION_ID" constraintName="JOB_EXEC_CTX_FK" referencedTableName="BATCH_JOB_EXECUTION" referencedColumnNames="JOB_EXECUTION_ID"/>
    </changeSet>
</databaseChangeLog>
