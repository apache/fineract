<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- PostgreSQL widens a VARCHAR without rewriting the table -->
    <changeSet author="fineract" id="1" context="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(1) from information_schema.columns where table_schema = current_schema()
                and table_name = 'm_portfolio_command_source' and column_name = 'api_get_url' and character_maximum_length &lt; 255</sqlCheck>
        </preConditions>
        <sql>
            ALTER TABLE m_portfolio_command_source ALTER COLUMN api_get_url TYPE VARCHAR(255)
        </sql>
    </changeSet>

    <!-- In utf8mb4 VARCHAR(100) is 400 bytes and VARCHAR(255) is 1020 bytes, both with a 2 byte length prefix, so MySQL and
         MariaDB widen the column in place. MODIFY replaces the whole column definition, so NOT NULL is repeated, and
         ALGORITHM=INPLACE makes the statement fail instead of silently copying the table. -->
    <changeSet author="fineract" id="2" context="mysql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(1) from information_schema.columns where table_schema = database()
                and table_name = 'm_portfolio_command_source' and column_name = 'api_get_url' and character_maximum_length &lt; 255</sqlCheck>
        </preConditions>
        <sql>
            ALTER TABLE m_portfolio_command_source MODIFY api_get_url VARCHAR(255) NOT NULL, ALGORITHM=INPLACE, LOCK=NONE
        </sql>
    </changeSet>
</databaseChangeLog>
