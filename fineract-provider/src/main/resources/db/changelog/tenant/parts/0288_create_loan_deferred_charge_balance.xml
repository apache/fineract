<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fineract" id="1" context="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_deferred_charge_balance"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_deferred_charge_balance">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_loan_deferred_charge_balance"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_adjustment" type="DECIMAL(19, 6)"/>
            <column name="unrecognized_amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="charged_off_amount" type="DECIMAL(19, 6)"/>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="window_end_date" type="DATE"/>
            <column name="period_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_type" type="VARCHAR(32)"/>
            <column name="income_type" type="VARCHAR(32)"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_closed" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="timestamp with time zone"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="timestamp with time zone"/>
        </createTable>
    </changeSet>
    <changeSet author="fineract" id="2" context="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_loan_deferred_charge_balance"/>
            </not>
        </preConditions>
        <createTable tableName="m_loan_deferred_charge_balance">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_m_loan_deferred_charge_balance"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="loan_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_adjustment" type="DECIMAL(19, 6)"/>
            <column name="unrecognized_amount" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="charged_off_amount" type="DECIMAL(19, 6)"/>
            <column name="date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="window_end_date" type="DATE"/>
            <column name="period_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_type" type="VARCHAR(32)"/>
            <column name="income_type" type="VARCHAR(32)"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_closed" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="DATETIME(6)"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="DATETIME(6)"/>
        </createTable>
    </changeSet>
    <changeSet author="fineract" id="3">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_loan_deferred_charge_balance"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_loan_deferred_charge_balance_loan_id"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="created_by" baseTableName="m_loan_deferred_charge_balance"
                                 constraintName="FK_loan_deferred_charge_balance_created_by" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_appuser" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="last_modified_by" baseTableName="m_loan_deferred_charge_balance"
                                 constraintName="FK_loan_deferred_charge_balance_last_modified_by" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_appuser" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="loan_id" baseTableName="m_loan_deferred_charge_balance"
                                 constraintName="FK_loan_deferred_charge_balance_loan_id" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_loan" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="loan_charge_id" baseTableName="m_loan_deferred_charge_balance"
                                 constraintName="FK_loan_deferred_charge_balance_loan_charge_id" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_loan_charge" validate="true"/>
        <addForeignKeyConstraint baseColumnNames="loan_transaction_id" baseTableName="m_loan_deferred_charge_balance"
                                 constraintName="FK_loan_deferred_charge_balance_transaction_id" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_loan_transaction" validate="true"/>
    </changeSet>
    <changeSet author="fineract" id="4" runInTransaction="false" context="postgresql">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_loan_deferred_charge_balance"/>
            <not>
                <indexExists tableName="m_loan_deferred_charge_balance" indexName="m_loan_deferred_charge_balance_idx_loan_closed"/>
            </not>
        </preConditions>
        <sql>
            create index concurrently if not exists m_loan_deferred_charge_balance_idx_loan_closed on m_loan_deferred_charge_balance(loan_id, is_closed);
            create index concurrently if not exists m_loan_deferred_charge_balance_idx_loan_charge on m_loan_deferred_charge_balance(loan_charge_id);
            create unique index concurrently if not exists m_loan_deferred_charge_balance_idx_loan_txn on m_loan_deferred_charge_balance(loan_id, loan_transaction_id);
        </sql>
    </changeSet>
    <changeSet author="fineract" id="5" context="mysql">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_loan_deferred_charge_balance"/>
            <not>
                <indexExists tableName="m_loan_deferred_charge_balance" indexName="m_loan_deferred_charge_balance_idx_loan_closed"/>
            </not>
        </preConditions>
        <sql>
            create index m_loan_deferred_charge_balance_idx_loan_closed on m_loan_deferred_charge_balance(loan_id, is_closed);
            create index m_loan_deferred_charge_balance_idx_loan_charge on m_loan_deferred_charge_balance(loan_charge_id);
            create unique index m_loan_deferred_charge_balance_idx_loan_txn on m_loan_deferred_charge_balance(loan_id, loan_transaction_id);
        </sql>
    </changeSet>
</databaseChangeLog>
