<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        A scheduler group greater than 0 gets a Quartz scheduler of its own with a single thread, so the jobs in it never
        run concurrently and, when several are due, the one with the highest task_priority goes first. The business date
        has to be replayed before Loan COB reads the COB date, which the shared 7 thread scheduler of group 0 cannot
        guarantee. Working Capital COB joins the group in the working capital module.
    -->
    <changeSet id="1" author="fineract">
        <update tableName="job">
            <column name="scheduler_group" valueNumeric="1"/>
            <where>name IN ('Increase Business Date by 1 day', 'Increase COB Date by 1 day', 'Loan COB')</where>
        </update>
    </changeSet>
</databaseChangeLog>
