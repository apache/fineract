<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="fineract" id="1">
        <comment>Store the identifiers a command returned separately, so the identifiers it was submitted with are kept.</comment>
        <addColumn tableName="m_portfolio_command_source">
            <column name="result_office_id" type="BIGINT"/>
            <column name="result_group_id" type="BIGINT"/>
            <column name="result_client_id" type="BIGINT"/>
            <column name="result_loan_id" type="BIGINT"/>
            <column name="result_savings_account_id" type="BIGINT"/>
            <column name="result_product_id" type="BIGINT"/>
            <column name="result_transaction_id" type="VARCHAR(100)"/>
            <column name="result_resource_id" type="BIGINT"/>
            <column name="result_resource_external_id" type="VARCHAR(100)"/>
            <column name="result_subresource_id" type="BIGINT"/>
            <column name="result_subresource_external_id" type="VARCHAR(100)"/>
            <column name="result_loan_external_id" type="VARCHAR(100)"/>
            <column name="result_ids_written" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet author="fineract" id="2">
        <comment>Mark rows whose identifier columns hold the values the command was submitted with from the moment they are inserted.</comment>
        <addColumn tableName="m_portfolio_command_source">
            <column name="submitted_ids_kept" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
