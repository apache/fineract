<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="fineract" id="1" dbms="postgresql">
        <sql>
            UPDATE c_configuration
            SET value = (SELECT value FROM c_configuration WHERE name = 'force-withdrawal-on-savings-account-limit')
            WHERE name = 'allow-force-withdrawal-on-savings-account';
        </sql>
    </changeSet>
    <changeSet author="fineract" id="2" dbms="mysql,mariadb">
        <sql>
            UPDATE c_configuration target
            JOIN c_configuration source ON source.name = 'force-withdrawal-on-savings-account-limit'
            SET target.value = source.value
            WHERE target.name = 'allow-force-withdrawal-on-savings-account';
        </sql>
    </changeSet>
    <changeSet author="fineract" id="3">
        <delete tableName="c_configuration">
            <where>name = 'force-withdrawal-on-savings-account-limit'</where>
        </delete>
    </changeSet>
</databaseChangeLog>
