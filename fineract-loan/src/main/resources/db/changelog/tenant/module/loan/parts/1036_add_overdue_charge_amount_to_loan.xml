<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="fineract" id="1">
        <addColumn tableName="m_loan">
            <column name="overdue_charge_amount" type="DECIMAL(19, 6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="2">
        <comment>Backfill overdue_charge_amount for existing loans so the overdue-installment charge amount stops
            drifting with future product-level charge changes.</comment>
        <sql>
            UPDATE m_loan SET overdue_charge_amount = (
                SELECT MIN(mc.amount) FROM m_product_loan_charge plc
                JOIN m_charge mc ON mc.id = plc.charge_id
                WHERE plc.product_loan_id = m_loan.product_id AND mc.charge_time_enum = 9)
        </sql>
    </changeSet>

</databaseChangeLog>
