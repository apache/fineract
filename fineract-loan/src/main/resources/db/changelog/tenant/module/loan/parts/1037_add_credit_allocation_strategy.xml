<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="fineract" id="1037-1">
        <addColumn tableName="m_loan_product_credit_allocation_rule">
            <column name="allocation_strategy" type="VARCHAR(50)" defaultValue="RULE_BASED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="m_loan_credit_allocation_rule">
            <column name="allocation_strategy" type="VARCHAR(50)" defaultValue="RULE_BASED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet author="fineract" id="1037-2">
        <dropNotNullConstraint tableName="m_loan_product_credit_allocation_rule" columnName="allocation_types" columnDataType="TEXT"/>
        <dropNotNullConstraint tableName="m_loan_credit_allocation_rule" columnName="allocation_types" columnDataType="TEXT"/>
        <!--
        allocation_types is nullable because only RULE_BASED rules carry an allocation order. This check keeps that
        guarantee for RULE_BASED rows: without an order the chargeback would be allocated to no portion at all.
        When adding a new credit allocation strategy, extend this condition if it needs (or must not have) an order.
        -->
        <sql>
            ALTER TABLE m_loan_product_credit_allocation_rule ADD CONSTRAINT chk_m_loan_product_credit_allocation_rule_types
                CHECK (allocation_strategy &lt;&gt; 'RULE_BASED' OR allocation_types IS NOT NULL)
        </sql>
        <sql>
            ALTER TABLE m_loan_credit_allocation_rule ADD CONSTRAINT chk_m_loan_credit_allocation_rule_types
                CHECK (allocation_strategy &lt;&gt; 'RULE_BASED' OR allocation_types IS NOT NULL)
        </sql>
    </changeSet>
</databaseChangeLog>
