<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet author="fineract" id="wcl-0067-loan-write-off-fields">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan"/>
            <not>
                <columnExists tableName="m_wc_loan" columnName="written_off_on_date"/>
            </not>
        </preConditions>
        <addColumn tableName="m_wc_loan">
            <column name="written_off_on_date" type="DATE"/>
            <!-- INT (not BIGINT) to match m_code_value.id: MySQL requires identical types on FK columns. -->
            <column name="write_off_reason_cv_id" type="INT"/>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="wcl-0067-loan-write-off-reason-fk">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan"/>
            <columnExists tableName="m_wc_loan" columnName="write_off_reason_cv_id"/>
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_m_wc_loan_write_off_reason"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="write_off_reason_cv_id" baseTableName="m_wc_loan"
                                 constraintName="FK_m_wc_loan_write_off_reason" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_code_value" validate="true"/>
    </changeSet>

    <changeSet author="fineract" id="wcl-0067-balance-written-off">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan_balance"/>
            <not>
                <columnExists tableName="m_wc_loan_balance" columnName="principal_written_off"/>
            </not>
        </preConditions>
        <addColumn tableName="m_wc_loan_balance">
            <column name="principal_written_off" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fee_written_off" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="penalty_written_off" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="wcl-0067-charge-written-off">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan_charge"/>
            <not>
                <columnExists tableName="m_wc_loan_charge" columnName="amount_written_off"/>
            </not>
        </preConditions>
        <addColumn tableName="m_wc_loan_charge">
            <column name="amount_written_off" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="wcl-0067-written-off-event">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_external_event_configuration WHERE type = 'WorkingCapitalLoanWrittenOffBusinessEvent'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_external_event_configuration">
            <column name="type" value="WorkingCapitalLoanWrittenOffBusinessEvent"/>
            <column name="enabled" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="wcl-0067-undo-written-off-event">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM m_external_event_configuration WHERE type = 'WorkingCapitalLoanUndoWrittenOffBusinessEvent'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_external_event_configuration">
            <column name="type" value="WorkingCapitalLoanUndoWrittenOffBusinessEvent"/>
            <column name="enabled" valueBoolean="false"/>
        </insert>
    </changeSet>

    <!-- Permissions: create BOTH write-off and undo write-off, mirroring the charge-off pair seeded in 0063. -->
    <!-- Without these rows the maker-checker lookup on WRITEOFF_WORKINGCAPITALLOAN fails and no role other than -->
    <!-- a super user (ALL_FUNCTIONS) can be granted the permission. -->
    <changeSet author="fineract" id="wcl-0067-write-off-permission">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'WRITEOFF_WORKINGCAPITALLOAN'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="WRITEOFF_WORKINGCAPITALLOAN"/>
            <column name="entity_name" value="WORKINGCAPITALLOAN"/>
            <column name="action_name" value="WRITEOFF"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="wcl-0067-undo-write-off-permission">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'UNDOWRITEOFF_WORKINGCAPITALLOAN'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="transaction_loan"/>
            <column name="code" value="UNDOWRITEOFF_WORKINGCAPITALLOAN"/>
            <column name="entity_name" value="WORKINGCAPITALLOAN"/>
            <column name="action_name" value="UNDOWRITEOFF"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
