<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Business date of the rate-change action. Distinct from created_on_utc, which remains system-clock audit. -->
    <changeSet author="fineract" id="wcl-0071-1-add-submitted-on-date">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan_period_payment_rate_change"/>
            <not>
                <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="submitted_on_date"/>
            </not>
        </preConditions>
        <addColumn tableName="m_wc_loan_period_payment_rate_change">
            <column name="submitted_on_date" type="DATE"/>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="wcl-0071-2-backfill-submitted-on-date">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="submitted_on_date"/>
            <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="created_on_utc"/>
        </preConditions>
        <update tableName="m_wc_loan_period_payment_rate_change">
            <column name="submitted_on_date" valueComputed="CAST(created_on_utc AS DATE)"/>
            <where>submitted_on_date IS NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
