<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Same-release rolling deploy: DEFAULT → backfill → NOT NULL (one changeset per table).
         DEFAULT covers N-1 writers that omit the column.
         MySQL/MariaDB: native MODIFY keeps NOT NULL + DEFAULT together;
         Liquibase addNotNullConstraint rewrites the column and drops the default for mysql,mariadb. -->

    <changeSet author="fineract" id="wcl-0074-1-period-payment-rate-submitted-on-date-not-null">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="submitted_on_date"/>
            <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="created_on_utc"/>
        </preConditions>
        <sql dbms="mysql,mariadb">
            ALTER TABLE m_wc_loan_period_payment_rate_change
                ALTER COLUMN submitted_on_date SET DEFAULT (CURRENT_DATE);
        </sql>
        <sql dbms="postgresql">
            ALTER TABLE m_wc_loan_period_payment_rate_change
                ALTER COLUMN submitted_on_date SET DEFAULT CURRENT_DATE;
        </sql>
        <update tableName="m_wc_loan_period_payment_rate_change">
            <column name="submitted_on_date" valueComputed="CAST(created_on_utc AS DATE)"/>
            <where>submitted_on_date IS NULL</where>
        </update>
        <sql dbms="mysql,mariadb">
            ALTER TABLE m_wc_loan_period_payment_rate_change
                MODIFY submitted_on_date date NOT NULL DEFAULT (CURRENT_DATE);
        </sql>
        <sql dbms="postgresql">
            ALTER TABLE m_wc_loan_period_payment_rate_change
                ALTER COLUMN submitted_on_date SET NOT NULL;
        </sql>
    </changeSet>

    <changeSet author="fineract" id="wcl-0074-2-near-breach-action-submitted-on-date-not-null">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_wc_loan_near_breach_action" columnName="submitted_on_date"/>
            <columnExists tableName="m_wc_loan_near_breach_action" columnName="created_on_utc"/>
        </preConditions>
        <sql dbms="mysql,mariadb">
            ALTER TABLE m_wc_loan_near_breach_action
                ALTER COLUMN submitted_on_date SET DEFAULT (CURRENT_DATE);
        </sql>
        <sql dbms="postgresql">
            ALTER TABLE m_wc_loan_near_breach_action
                ALTER COLUMN submitted_on_date SET DEFAULT CURRENT_DATE;
        </sql>
        <update tableName="m_wc_loan_near_breach_action">
            <column name="submitted_on_date" valueComputed="CAST(created_on_utc AS DATE)"/>
            <where>submitted_on_date IS NULL</where>
        </update>
        <sql dbms="mysql,mariadb">
            ALTER TABLE m_wc_loan_near_breach_action
                MODIFY submitted_on_date date NOT NULL DEFAULT (CURRENT_DATE);
        </sql>
        <sql dbms="postgresql">
            ALTER TABLE m_wc_loan_near_breach_action
                ALTER COLUMN submitted_on_date SET NOT NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
