<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="wcl-0077-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_wc_loan" columnName="overpaid_on_date"/>
            </not>
        </preConditions>
        <addColumn tableName="m_wc_loan">
            <column name="overpaid_on_date" type="DATE" defaultValueComputed="NULL"/>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="wcl-0077-2">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan"/>
            <tableExists tableName="m_wc_loan_transaction"/>
            <tableExists tableName="m_wc_loan_transaction_allocation"/>
        </preConditions>
        <sql>
            UPDATE m_wc_loan
            SET overpaid_on_date = (SELECT MIN(t.transaction_date)
                                    FROM m_wc_loan_transaction t
                                    INNER JOIN m_wc_loan_transaction_allocation a
                                        ON a.wc_loan_transaction_id = t.id
                                    WHERE t.wc_loan_id = m_wc_loan.id
                                      AND t.is_reversed = FALSE
                                      AND a.overpayment_portion &gt; 0)
            WHERE m_wc_loan.overpaid_on_date IS NULL
              AND m_wc_loan.loan_status_id = 700
        </sql>
    </changeSet>

</databaseChangeLog>
