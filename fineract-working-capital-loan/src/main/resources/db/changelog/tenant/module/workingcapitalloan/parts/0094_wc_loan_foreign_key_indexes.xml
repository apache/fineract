<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Per-loan reads and deletes on these columns scanned the whole table. m_wc_loan_charge.loan_id has no foreign key
         and no index on any database. The others carry only a foreign key, which MySQL and MariaDB back with an index
         of their own but PostgreSQL does not; on MySQL/MariaDB the explicit index takes over that role.
         CONCURRENTLY on PostgreSQL so the build does not lock the table. -->
    <changeSet author="fineract" id="wcl-0094-1-pg" runInTransaction="false" context="postgresql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM pg_indexes WHERE tablename = 'm_wc_loan_charge' AND indexname = 'idx_wc_loan_charge_loan_id';
            </sqlCheck>
        </preConditions>
        <sql>
            CREATE INDEX CONCURRENTLY idx_wc_loan_charge_loan_id ON m_wc_loan_charge(loan_id);
        </sql>
    </changeSet>

    <changeSet author="fineract" id="wcl-0094-1-mysql" runInTransaction="false" context="mysql">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM information_schema.statistics
                WHERE table_schema = DATABASE() AND table_name = 'm_wc_loan_charge' AND index_name = 'idx_wc_loan_charge_loan_id';
            </sqlCheck>
        </preConditions>
        <sql>
            CREATE INDEX idx_wc_loan_charge_loan_id ON m_wc_loan_charge(loan_id);
        </sql>
    </changeSet>

