<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Until the schedule honoured the repayment frequency every schedule was daily, whatever the product or the loan
         stored, and PAYMENT_AMOUNT products were configured in daily amounts. Products, and loans that have no schedule
         yet, are normalized to DAYS/1 so they keep scheduling daily. A loan still awaiting approval counts as having no
         schedule: a model left behind by an undone approval is rebuilt from the loan when it is approved again. Loans
         with a schedule keep what they stored; their rebuilds take the frequency from the schedule itself. -->
    <changeSet author="fineract" id="wcl-0087-1-normalize-product-repayment-frequency">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan_product"/>
        </preConditions>
        <update tableName="m_wc_loan_product">
            <column name="repayment_every" valueNumeric="1"/>
            <column name="repayment_frequency_enum" value="DAYS"/>
            <where>repayment_every &lt;&gt; 1 OR repayment_frequency_enum &lt;&gt; 'DAYS'</where>
        </update>
    </changeSet>

    <changeSet author="fineract" id="wcl-0087-2-normalize-unscheduled-loan-repayment-frequency">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_wc_loan"/>
            <tableExists tableName="m_wc_loan_amortization_model"/>
        </preConditions>
        <update tableName="m_wc_loan">
            <column name="repayment_every" valueNumeric="1"/>
            <column name="repayment_frequency_enum" value="DAYS"/>
            <where>(repayment_every IS NULL OR repayment_every &lt;&gt; 1 OR repayment_frequency_enum IS NULL OR repayment_frequency_enum &lt;&gt; 'DAYS')
                AND (loan_status_id = 100
                    OR NOT EXISTS (SELECT 1 FROM m_wc_loan_amortization_model am WHERE am.loan_id = m_wc_loan.id))</where>
        </update>
    </changeSet>

</databaseChangeLog>
