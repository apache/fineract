<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="wcl-0064-1-create-charge-paid-by-table">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_wc_loan_charge_paid_by"/>
            </not>
        </preConditions>
        <createTable tableName="m_wc_loan_charge_paid_by">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="wc_loan_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="wc_loan_charge_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="fineract" id="wcl-0064-2-charge-paid-by-fks">
        <addForeignKeyConstraint baseColumnNames="wc_loan_transaction_id" baseTableName="m_wc_loan_charge_paid_by"
                                 constraintName="fk_wc_charge_paid_by_transaction" referencedColumnNames="id"
                                 referencedTableName="m_wc_loan_transaction"/>
        <addForeignKeyConstraint baseColumnNames="wc_loan_charge_id" baseTableName="m_wc_loan_charge_paid_by"
                                 constraintName="fk_wc_charge_paid_by_charge" referencedColumnNames="id"
                                 referencedTableName="m_wc_loan_charge"/>
    </changeSet>

    <!-- No index on wc_loan_transaction_id alone: the unique constraint below leads on that column, so its backing
         index already serves the per-transaction lookups and the delete-by-loan reset. -->
    <changeSet author="fineract" id="wcl-0064-3-charge-paid-by-indexes">
        <createIndex tableName="m_wc_loan_charge_paid_by" indexName="idx_wc_charge_paid_by_charge">
            <column name="wc_loan_charge_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="wcl-0064-4-charge-paid-by-unique">
        <addUniqueConstraint columnNames="wc_loan_transaction_id, wc_loan_charge_id"
                             constraintName="uq_m_wc_loan_charge_paid_by_transaction_charge"
                             tableName="m_wc_loan_charge_paid_by"/>
    </changeSet>

</databaseChangeLog>
