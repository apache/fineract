<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
        Widened to the width of the decimal(27,8) Avro field the same rate is published in, which is also the ceiling
        the schedule solver caps the calculated annual EIR at. At DECIMAL(19,6) the column stopped at 1E+13 %, well
        below that cap: a loan carrying a discount fee close to its principal amortizes over few days and solves to a
        rate of far greater magnitude, so booking a payment rate change on it failed on the insert - after the schedule
        had already been rewritten. Widening the column rather than lowering the cap keeps the snapshot able to record
        whatever the solver is allowed to produce. The stored value still carries six decimals; the two extra are
        headroom for matching the published scale, not a change of precision. The column is nullable, so the NOT NULL
        that modifyDataType drops on MySQL/MariaDB is not one this table has.
    -->
    <changeSet author="fineract" id="wcl-0087-1-widen-calculated-annual-eir">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="m_wc_loan_period_payment_rate_change"/>
                <columnExists tableName="m_wc_loan_period_payment_rate_change" columnName="calculated_annual_eir"/>
            </and>
        </preConditions>
        <modifyDataType tableName="m_wc_loan_period_payment_rate_change" columnName="calculated_annual_eir"
                        newDataType="DECIMAL(27, 8)"/>
    </changeSet>

</databaseChangeLog>
