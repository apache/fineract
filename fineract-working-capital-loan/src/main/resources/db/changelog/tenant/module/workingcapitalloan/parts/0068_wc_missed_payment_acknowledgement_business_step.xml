<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Placed ahead of every step that reads the projected amortization schedule, so they see a projection that is
         current as at today rather than one still assuming instalments that never arrived. -->
    <changeSet author="fineract" id="wcl-0068-1">
        <update tableName="m_batch_business_steps">
            <column name="step_order" valueComputed="step_order + 1"/>
            <where>job_name='WORKING_CAPITAL_LOAN_CLOSE_OF_BUSINESS' AND step_order >= 2</where>
        </update>
        <insert tableName="m_batch_business_steps">
            <column name="job_name" value="WORKING_CAPITAL_LOAN_CLOSE_OF_BUSINESS"/>
            <column name="step_name" value="WC_MISSED_PAYMENT_ACKNOWLEDGEMENT"/>
            <column name="step_order" value="2"/>
        </insert>
        <rollback>
            <delete tableName="m_batch_business_steps">
                <where>step_name='WC_MISSED_PAYMENT_ACKNOWLEDGEMENT'</where>
            </delete>
            <update tableName="m_batch_business_steps">
                <column name="step_order" valueComputed="step_order - 1"/>
                <where>job_name='WORKING_CAPITAL_LOAN_CLOSE_OF_BUSINESS' AND step_order >= 3</where>
            </update>
        </rollback>
    </changeSet>

</databaseChangeLog>
