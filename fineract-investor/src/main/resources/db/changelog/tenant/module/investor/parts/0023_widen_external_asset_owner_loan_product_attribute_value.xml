<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Multi value attributes such as EXCLUDED_TRANSACTION_TYPES hold a comma separated list of values, which does
         not fit into the original 255 characters. modifyDataType drops NOT NULL on MySQL/MariaDB, so it is re-applied. -->
    <changeSet author="fineract" id="1">
        <modifyDataType tableName="m_external_asset_owner_loan_product_configurable_attributes"
                        columnName="attribute_value"
                        newDataType="VARCHAR(2000)"/>
        <addNotNullConstraint tableName="m_external_asset_owner_loan_product_configurable_attributes"
                              columnName="attribute_value"
                              columnDataType="VARCHAR(2000)"/>
    </changeSet>
</databaseChangeLog>
